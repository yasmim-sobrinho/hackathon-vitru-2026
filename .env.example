# Copie para apps/web/.env.local e preencha. NUNCA commitar .env.local.
# Este arquivo contém apenas NOMES de variáveis, nenhum valor real.

# Qual implementação de AgentAdapter usar.
# mock (default) | agentforce
# A demo precisa funcionar com mock. Ver ADR-005.
VITE_AGENT_MODE=mock

# Somente necessário quando VITE_AGENT_MODE=agentforce.
# Se qualquer uma faltar, o app cai no mock em vez de quebrar.
VITE_SF_INSTANCE_URL=
VITE_SF_AGENT_ID=

# Credenciais do Salesforce NÃO vão aqui.
# A autenticação da org é feita pelo Salesforce CLI e fica no keychain local:
#   sf org login web --alias vitru-hackathon --set-default
